<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Back-Office – Delivery App</title>
  <style>
    body { margin: 0; font-family: Arial, sans-serif; background: #f5f5f5; color: #222; }
    header { display: flex; justify-content: space-between; align-items: center;
             padding: 16px 24px; background: #d9480f; color: #fff; }
    header h1 { margin: 0; font-size: 20px; }
    header button { padding: 8px 16px; border: 0; border-radius: 4px; cursor: pointer;
                    background: #fff; color: #d9480f; font-weight: bold; }
    main { max-width: 900px; margin: 32px auto; padding: 0 16px; }
    .cartes { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
    .carte { background: #fff; border-radius: 8px; padding: 20px; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    .carte h2 { margin: 0 0 8px; font-size: 16px; }
    .carte p { margin: 0; color: #666; font-size: 14px; }
  </style>
</head>
<body>
  <header>
    <h1>Back-Office restaurant</h1>
    <form method="POST" action="/admin/logout">
      <button type="submit">Se déconnecter</button>
    </form>
  </header>

  <main>
    <p>Bienvenue, <strong><%= agent.prenom %> <%= agent.nom %></strong></p>

    <div class="cartes">
      <a class="carte" href="/admin/categories" style="text-decoration: none; color: inherit;">
        <h2>Catégories</h2>
        <p>Organiser la carte et ajouter des catégories</p>
      </a>
      <a class="carte" href="/admin/produits" style="text-decoration: none; color: inherit;">
        <h2>Produits</h2>
        <p>Lister, filtrer et modifier les produits</p>
      </a>
      <a class="carte" href="/admin/menus-composes" style="text-decoration: none; color: inherit;">
        <h2>Menus composés</h2>
        <p>Créer et modifier les formules</p>
      </a>
           <a class="carte" href="/admin/commandes" style="text-decoration: none; color: inherit;">
        <h2>Commandes</h2>
        <p>Suivre et valider les commandes</p>
      </a>
      <a class="carte" href="/admin/livreurs" style="text-decoration: none; color: inherit;">
  <h2>Livreurs</h2>
  <p>Gérer les demandes et l'équipe</p>
</a>
    </div>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titre %> – Back-Office</title>
  <style>
    body { margin: 0; font-family: Arial, sans-serif; background: #f5f5f5; color: #222; }
    header { display: flex; justify-content: space-between; align-items: center;
             padding: 16px 24px; background: #d9480f; color: #fff; }
    header a { color: #fff; text-decoration: none; font-weight: bold; }
    main { max-width: 900px; margin: 32px auto; padding: 0 16px; }
    .bloc { background: #fff; border-radius: 8px; padding: 20px; margin-bottom: 16px;
            box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    .bloc h2 { margin: 0 0 12px; font-size: 18px; }
    .succes { background: #e6f4ea; color: #1e6b34; padding: 12px; border-radius: 4px; margin-bottom: 16px; }
    .erreur { color: #c92a2a; font-size: 13px; margin: 4px 0 0; }
    label { display: block; margin: 12px 0 4px; font-weight: bold; }
    input[type=text], input[type=number], textarea, select { width: 100%; padding: 8px; box-sizing: border-box;
            border: 1px solid #ccc; border-radius: 4px; }
    .bouton { display: inline-block; margin-top: 16px; padding: 10px 16px; border: 0; border-radius: 4px;
              background: #d9480f; color: #fff; font-weight: bold; cursor: pointer; text-decoration: none; }
    .produit { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-top: 1px solid #eee; }
    .produit img { width: 56px; height: 56px; object-fit: cover; border-radius: 4px; }
    .produit .prix { margin-left: auto; font-weight: bold; }
    .indisponible { color: #999; font-size: 13px; }
    
.bo-header{display:flex;justify-content:space-between;padding:12px 24px;border-bottom:1px solid #ccc}
.bo-header a{color:#0b57a4;text-decoration:none}
main{padding:16px 24px}
.page-head{display:flex;justify-content:space-between;align-items:center}
.btn{display:inline-block;padding:6px 14px;border:1px solid #555;border-radius:6px;background:#fff;cursor:pointer;text-decoration:none;color:#222}
.btn.primary{background:#222;color:#fff}
.grid{width:100%;border-collapse:collapse}
.grid th,.grid td{border:1px solid #ccc;padding:8px;text-align:left}
.grid th{background:#eee}
.flash{padding:8px 12px;border:1px solid #2e7d32;background:#e8f5e9;margin:12px 0}
.cols{display:flex;gap:32px}.col-left{flex:1}.col-right{flex:2}
label{display:block;margin-top:12px;font-weight:600}
label input[type=text],label input[type=number]:not(.sm){width:100%;box-sizing:border-box;padding:6px}
.check{display:flex;gap:6px;align-items:center}
.hint{color:#777;font-size:.85em}
.err{color:#c00;font-size:.9em;margin-top:4px}
.warn{color:#8a5a00;font-size:.9em;margin-top:4px}
.box{border:1px solid currentColor;padding:8px 12px;margin:8px 0}
.groupe{border:1px solid #444;padding:12px;margin-bottom:12px}
.groupe-head{display:flex;gap:12px;align-items:flex-end}
.groupe-head label{margin-top:0}
.groupe-head input[type=number]{width:70px!important}
.tools{margin-left:auto;display:flex;gap:4px}
.option-row{display:flex;gap:12px;align-items:center;margin-top:8px;flex-wrap:wrap}
.option-row label{margin:0;font-weight:400}
.option-row input[type=number]{width:90px}
.link{background:none;border:none;color:#0b57a4;cursor:pointer;margin-top:8px;padding:0}
.actions{display:flex;justify-content:space-between;margin-top:24px}
[hidden]{display:none!important}
  </style>
</head>
<body>
  <header>
    <a href="/admin">← Back-Office restaurant</a>
    <span><%= titre %></span>
  </header>
  <main>

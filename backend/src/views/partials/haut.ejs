<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titre %> – Back-Office</title>
  <style>
    body { margin: 0; font-family: Arial, sans-serif; background: #f5f5f5; color: #222; }
    header { display: flex; justify-content: space-between; align-items: center;
             padding: 16px 24px; background: #d9480f; color: #fff; }
    header a { color: #fff; text-decoration: none; font-weight: bold; }
    main { max-width: 900px; margin: 32px auto; padding: 0 16px; }
    .bloc { background: #fff; border-radius: 8px; padding: 20px; margin-bottom: 16px;
            box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    .bloc h2 { margin: 0 0 12px; font-size: 18px; }
    .succes { background: #e6f4ea; color: #1e6b34; padding: 12px; border-radius: 4px; margin-bottom: 16px; }
    .erreur { color: #c92a2a; font-size: 13px; margin: 4px 0 0; }
    label { display: block; margin: 12px 0 4px; font-weight: bold; }
    input[type=text], input[type=number], textarea, select { width: 100%; padding: 8px; box-sizing: border-box;
            border: 1px solid #ccc; border-radius: 4px; }
    .bouton { display: inline-block; margin-top: 16px; padding: 10px 16px; border: 0; border-radius: 4px;
              background: #d9480f; color: #fff; font-weight: bold; cursor: pointer; text-decoration: none; }
    .produit { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-top: 1px solid #eee; }
    .produit img { width: 56px; height: 56px; object-fit: cover; border-radius: 4px; }
    .produit .prix { margin-left: auto; font-weight: bold; }
    .indisponible { color: #999; font-size: 13px; }
  </style>
</head>
<body>
  <header>
    <a href="/admin">← Back-Office restaurant</a>
    <span><%= titre %></span>
  </header>
  <main>

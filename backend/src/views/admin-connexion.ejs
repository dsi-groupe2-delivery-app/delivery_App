<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Connexion agent – Back-Office</title>
  <style>
    body { margin: 0; font-family: Arial, sans-serif; background: #f5f5f5; color: #222;
           display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .bloc { width: 100%; max-width: 360px; background: #fff; border-radius: 8px; padding: 32px;
            box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    h1 { margin: 0 0 4px; font-size: 22px; color: #d9480f; }
    .sous-titre { margin: 0 0 24px; color: #666; font-size: 14px; }
    label { display: block; margin: 16px 0 4px; font-weight: bold; }
    input { width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
    button { width: 100%; margin-top: 24px; padding: 12px; border: 0; border-radius: 4px;
             background: #d9480f; color: #fff; font-weight: bold; cursor: pointer; }
    .erreur { background: #fdecea; color: #c92a2a; padding: 10px; border-radius: 4px; font-size: 14px; }
  </style>
</head>
<body>
  <div class="bloc">
    <h1>Back-Office restaurant</h1>
    <p class="sous-titre">Espace réservé aux agents</p>

    <% if (erreur) { %>
      <p class="erreur"><%= erreur %></p>
    <% } %>

    <form method="POST" action="/admin/connexion">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" value="<%= email %>" required>

      <label for="password">Mot de passe</label>
      <input type="password" id="password" name="password" required>

      <button type="submit">Se connecter</button>
    </form>
  </div>
</body>
</html>

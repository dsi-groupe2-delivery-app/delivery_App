# Copier ce fichier en .env (jamais commité) et remplir les valeurs
# URI MongoDB (local : mongodb://127.0.0.1:27017/delivery_app). MONGODB_URI est aussi accepté.
MONGO_URI=
# Longue chaîne aléatoire, différente en local et sur Azure
SESSION_SECRET=
PORT=3000
NODE_ENV=development
# URL du front Angular (redirections vers /connexion et CORS)
FRONT_URL=http://localhost:4200

EMAIL_USER=
EMAIL_PASS=